# ========================================================
# 1. LOCAL DEVELOPMENT (.env on your computer)
# ========================================================
NODE_ENV=development
PORT=3000
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_2026
ADMIN_TEAM=abrar
ADMIN_PASSWORD=abrar@10
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# ========================================================
# 2. RENDER BACKEND (Add under Render > Environment Variables)
# ========================================================
# NODE_ENV=production
# NODE_VERSION=20.18.0
# JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_2026
# ADMIN_TEAM=abrar
# ADMIN_PASSWORD=abrar@10
# CORS_ORIGIN=https://coding-cubs.vercel.app

# ========================================================
# 3. VERCEL FRONTEND (Add under Vercel > Settings > Environment Variables)
# ========================================================
# VITE_API_URL=https://coding-cubs-api.onrender.com
